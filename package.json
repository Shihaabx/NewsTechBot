{
  "name":"newstechbot",
  "version":"0.2.1",
  "private":true,
  "description":"NewsTech — curated technology news intelligence for the Juraa Tech newsroom.",
  "type":"module",
  "engines":{"node":">=22"},
  "scripts":{
    "dev":"tsx watch src/index.ts",
    "start":"node dist/src/index.js",
    "build":"tsc -p tsconfig.json",
    "typecheck":"tsc -p tsconfig.json --noEmit",
    "test":"vitest run",
    "check":"npm run typecheck && npm run test && npm run build"
  },
  "dependencies":{
    "discord.js":"^14.21.0",
    "dotenv":"^16.4.7",
    "rss-parser":"^3.13.0",
    "yaml":"^2.8.1",
    "zod":"^3.25.76"
  },
  "devDependencies":{
    "@types/node":"^22.15.30",
    "tsx":"^4.20.3",
    "typescript":"^5.8.3",
    "vitest":"^3.2.4"
  }
}
