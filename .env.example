# Discord connection (secrets stay here, not in the dashboard)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Required to unlock workflow buttons: only these Discord users can press Video Idea / Used buttons.
NEWSTECH_ALLOWED_USER_IDS=

# First-run defaults. After startup, these are managed from the Dashboard.
DISCORD_CHANNEL_INCOMING=
DISCORD_CHANNEL_BREAKING=
DISCORD_CHANNEL_AI=
DISCORD_CHANNEL_PC_HARDWARE=
DISCORD_CHANNEL_WINDOWS_SOFTWARE=
DISCORD_CHANNEL_GAMING_TECH=
DISCORD_CHANNEL_CYBERSECURITY=
DISCORD_CHANNEL_GENERAL_TECH=
DISCORD_CHANNEL_VIDEO_IDEAS=
DISCORD_CHANNEL_USED_NEWS=

POLL_INTERVAL_MINUTES=10
MAX_ITEMS_PER_SOURCE=15
MAX_ARTICLE_AGE_HOURS=72
NEWS_MIN_SCORE=58
BREAKING_MIN_SCORE=82

# Local files
DATA_PATH=./data/state.json
SETTINGS_PATH=./data/settings.json
INBOX_PATH=./data/inbox.json
BRAND_LOGO_PATH=./data/brand-logo.json
SOURCES_PATH=./config/sources.yml
RULES_PATH=./config/rules.yml

DRY_RUN=false

# Control Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Optional on localhost. REQUIRED (16+ chars) if DASHBOARD_HOST is exposed remotely.
DASHBOARD_TOKEN=
